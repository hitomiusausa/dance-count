{
  "name": "dance-count-for-ballroom",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node tools/check-dist.js",
    "preview": "vite preview",
    "deploy:cf": "RELEASE=1 PUBLIC_APP_URL=https://count.dancemap.jp npm run build && npx -y wrangler@latest deploy",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json",
    "test": "node --test \"test/**/*.test.{js,ts}\"",
    "legacy": "python3 -m http.server 4173",
    "routines:migrate": "node tools/migrate-legacy-routines.js",
    "voices:generate": "node tools/generate-google-voices.js",
    "voices:measure": "node tools/measure-voice-onsets.js",
    "voices:audit-recording": "node tools/audit-recorded-voice-pack.js",
    "timing:audit": "node tools/audit-all-dance-timing.js",
    "terminology:audit": "node tools/audit-figure-terminology.js",
    "audio:subdivision-review": "node tools/render-subdivision-audio-review.js",
    "voices:build": "node tools/generate-google-voices.js --measure",
    "voices:plan": "node tools/voices/generate.js --dry-run",
    "voices:synth": "node tools/voices/generate.js",
    "voices:process": "node tools/voices/process.js",
    "voices:check": "node tools/voices/check-pack.js",
    "voices:gate": "node tools/voices/render-gate.js",
    "voices:adopt": "node tools/voices/adopt.js",
    "voices:six-candidates": "node tools/generate-six-candidates.js",
    "ui:check": "node tools/check-app-ui.js",
    "ui:check:music": "node tools/check-music-ui.js",
    "ui:check:legacy": "node tools/check-ui-accessibility.js",
    "smoke:practice": "node tools/smoke-practice.js",
    "smoke:music": "node tools/smoke-music.js",
    "smoke:routines": "node tools/smoke-routines.js",
    "smoke:voice": "node tools/smoke-voice.js",
    "smoke:share": "node tools/smoke-share.js",
    "smoke:pwa": "node tools/smoke-pwa.js",
    "fixtures:share": "node tools/make-share-fixtures.js",
    "timing:compare": "node tools/compare-timing-audit.js",
    "copy:sheet": "node tools/i18n/copy-review-sheet.js",
    "i18n:phrases": "node tools/i18n/segment-ja.js",
    "smoke:music:waveform": "node tools/smoke-waveform-review.js",
    "smoke:music:library": "node tools/smoke-music-library.js",
    "smoke:music:routines": "node tools/smoke-music-routines.js",
    "smoke:music:use-routines": "node tools/smoke-use-music-routines.js"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.19.2",
    "budoux": "0.9.3",
    "playwright-core": "^1.61.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "workbox-build": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
