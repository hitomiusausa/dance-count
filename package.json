{
  "name": "dance-count-for-ballroom",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node tools/check-dist.js",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.{js,ts}\"",
    "legacy": "python3 -m http.server 4173",
    "routines:migrate": "node tools/migrate-legacy-routines.js",
    "voices:generate": "node tools/generate-google-voices.js",
    "voices:measure": "node tools/measure-voice-onsets.js",
    "voices:audit-recording": "node tools/audit-recorded-voice-pack.js",
    "timing:audit": "node tools/audit-all-dance-timing.js",
    "terminology:audit": "node tools/audit-figure-terminology.js",
    "audio:subdivision-review": "node tools/render-subdivision-audio-review.js",
    "voices:build": "npm run voices:generate && npm run voices:measure",
    "voices:six-candidates": "node tools/generate-six-candidates.js",
    "ui:check": "node tools/check-app-ui.js",
    "ui:check:legacy": "node tools/check-ui-accessibility.js",
    "smoke:practice": "node tools/smoke-practice.js",
    "timing:compare": "node tools/compare-timing-audit.js"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.19.2",
    "playwright-core": "^1.61.1",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
